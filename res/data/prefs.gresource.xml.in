<?xml version="1.0" encoding="UTF-8"?>
<gresources>
    <gresource prefix="@path@theme">
        <file compressed="true">@theme@</file>
    </gresource>
    <gresource prefix="@path@icons">
        <file preprocess="xml-stripblanks" compressed="true">scalable/status/@icon_swift_passive@</file>
        <file preprocess="xml-stripblanks" compressed="true">scalable/status/@icon_popup_passive@</file>
    </gresource>
</gresources>
