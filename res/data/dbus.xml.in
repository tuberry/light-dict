<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
     NOTE: Maybe - https://gitlab.freedesktop.org/dbus/dbus/-/issues/25
-->
<node>
    <interface name="@dbus@">
        <method name="OCR">
            <arg type="s" direction="in" name="args"/>
        </method>
        <method name="Run">
            <arg type="s" direction="in" name="type"/>
            <arg type="s" direction="in" name="text"/>
            <arg type="s" direction="in" name="info"/>
            <arg type="ai" direction="in" name="area"/>
        </method>
        <method name="Get">
            <arg type="(ii)" direction="out" name="pointer"/>
            <arg type="d" direction="out" name="zoom"/>
            <arg type="(iiii)" direction="out" name="geometry"/>
        </method>
    </interface>
</node>
