<?xml version="1.0" encoding="UTF-8"?>
<gresources>
    <gresource prefix="/org/gnome/shell/dbus-interfaces">
        <file preprocess="xml-stripblanks" compressed="true">@dbus@.xml</file>
    </gresource>
    <gresource prefix="/org/gnome/shell/icons">
        <file preprocess="xml-stripblanks" compressed="true">scalable/status/@icon_swift_passive@</file>
        <file preprocess="xml-stripblanks" compressed="true">scalable/status/@icon_swift_proactive@</file>
        <file preprocess="xml-stripblanks" compressed="true">scalable/status/@icon_popup_passive@</file>
        <file preprocess="xml-stripblanks" compressed="true">scalable/status/@icon_popup_proactive@</file>
        <file preprocess="xml-stripblanks" compressed="true">scalable/status/@icon_disable_passive@</file>
        <file preprocess="xml-stripblanks" compressed="true">scalable/status/@icon_disable_proactive@</file>
    </gresource>
</gresources>
